# Server-side only. This key is read by the /api/chat function and is never
# exposed to the browser — note the deliberate absence of a VITE_ prefix, which
# would inline it into the client bundle for anyone to read.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Leaving the key unset is a valid configuration: the app falls back to
# scripted demo responses so the interface stays fully usable.
